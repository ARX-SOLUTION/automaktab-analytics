{
 "$schema":"../../node_modules/wrangler/config-schema.json",
 "name":"automaktab-analytics-worker",
 "main":"src/cloudflare.ts",
 "compatibility_date":"2026-10-03",
 "alias":{
  "class-validator":"./src/unsupported-nest-optional.ts",
  "class-transformer":"./src/unsupported-nest-optional.ts",
  "@nestjs/microservices":"./src/unsupported-nest-optional.ts",
  "@nestjs/microservices/microservices-module.js":"./src/unsupported-nest-optional.ts",
  "@nestjs/websockets/socket-module.js":"./src/unsupported-nest-optional.ts"
 },
 "assets":{
  "directory":"../web/dist",
  "binding":"ASSETS",
  "not_found_handling":"single-page-application",
  "run_worker_first":["/api/*","/collect/*","/internal/*","/health/*"]
 },
 "hyperdrive":[{
  "binding":"HYPERDRIVE",
  "id":"00000000000000000000000000000000",
  "localConnectionString":"postgresql://synthetic:synthetic-local-only@checks-db:5432/automaktab_synthetic"
 }],
 "queues":{
  "producers":[{"binding":"INBOX_WAKEUPS","queue":"automaktab-analytics-inbox-wakeup"}],
  "consumers":[{"queue":"automaktab-analytics-inbox-wakeup","max_batch_size":10,"max_batch_timeout":1,"max_retries":5,"max_concurrency":1}]
 },
 "triggers":{"crons":["* * * * *"]},
 "vars":{"APP_ENV":"synthetic","PUBLIC_ORIGIN":"http://127.0.0.1:18517"}
}
