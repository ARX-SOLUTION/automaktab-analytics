# Public-safe local synthetic settings; Compose supplies these explicitly.
APP_ENV=synthetic
DATABASE_URL=postgresql://synthetic:synthetic-local-only@db:5432/automaktab_synthetic
PORT=3000

# Production configuration is explicit and fails closed when any required field is absent.
# Set these in the deployment secret/configuration store, never commit real values.
# APP_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@DATABASE:5432/NAME?sslmode=verify-full
# PUBLIC_ORIGIN=https://analytics.example.test
# FOUNDER_ID=EXACT_CONFIRMED_CRM_USER_ID
# CRM_SOURCE_URL=https://api.example.test/
# CRM_AUTHORIZE_URL=https://crm.example.test/analytics
# SSO_AUDIENCE=https://analytics.example.test
# CRM_SOURCE_SERVICE_TOKEN=DEDICATED_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
# INGEST_TOKEN=SEPARATE_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
# PUBLIC_INGEST_ORIGINS=https://marketing.example.test,https://crm.example.test
# CRM_SOURCE_URL is the actual backend base; current CRM routes have no /api prefix.
